# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Server & Runtime Configuration
NODE_ENV=
PORT=

# MongoDB Atlas Database Connectivity
MONGODB_URI=

# Cloudinary Media Architecture
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication & Session Secrets
AUTH_SECRET=
SESSION_SECRET=

# Admin Bootstrap Credentials
# Verified server-side on POST /api/v1/admin/login. If either variable is
# missing the endpoint answers 503 (not 401) so the misconfiguration is visible.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Transactional Email via Resend HTTP API
RESEND_API_KEY=
EMAIL_FROM=

# Bangladesh Payment Gateways
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
